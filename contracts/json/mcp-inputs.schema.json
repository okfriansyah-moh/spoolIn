{
  "movie_context": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string",
        "maxLength": 200
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 20
      }
    },
    "required": [
      "query"
    ],
    "additionalProperties": false
  },
  "propose_movie": {
    "type": "object",
    "properties": {
      "operationId": {
        "type": "string",
        "format": "uuid"
      },
      "title": {
        "type": "string",
        "minLength": 1,
        "maxLength": 255
      },
      "originalTitle": {
        "type": [
          "string",
          "null"
        ]
      },
      "synopsis": {
        "type": "string",
        "minLength": 1,
        "maxLength": 5000
      },
      "genreIds": {
        "type": "array",
        "minItems": 1,
        "maxItems": 20,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "format": "uuid"
        }
      },
      "release": {
        "type": "object",
        "properties": {
          "year": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9999
          },
          "month": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 12
          },
          "day": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 31
          }
        },
        "required": [
          "year"
        ],
        "additionalProperties": false
      },
      "synopsisLanguage": {
        "type": "string"
      },
      "originalLanguage": {
        "type": [
          "string",
          "null"
        ]
      },
      "countries": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "runtimeMinutes": {
        "type": [
          "integer",
          "null"
        ],
        "minimum": 1,
        "maximum": 100000
      },
      "proposalId": {
        "type": "string",
        "format": "uuid"
      },
      "expectedRevision": {
        "type": "integer",
        "minimum": 1
      },
      "sources": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "maxLength": 2048
            },
            "field": {
              "type": "string"
            },
            "reuseBasis": {
              "type": "string",
              "maxLength": 4000
            }
          },
          "required": [
            "url",
            "field",
            "reuseBasis"
          ],
          "additionalProperties": false
        }
      },
      "posterRef": {
        "type": "string",
        "format": "uuid",
        "description": "Owned prepared poster reference returned by prepare_movie_poster in READY state."
      }
    },
    "required": [
      "operationId",
      "title",
      "synopsis",
      "genreIds",
      "release"
    ],
    "additionalProperties": false
  },
  "movie_operation": {
    "type": "object",
    "properties": {
      "operationId": {
        "type": "string",
        "format": "uuid"
      }
    },
    "required": [
      "operationId"
    ],
    "additionalProperties": false
  },
  "approve_movie": {
    "type": "object",
    "properties": {
      "proposalId": {
        "type": "string",
        "format": "uuid"
      },
      "revision": {
        "type": "integer",
        "minimum": 1
      },
      "contentHash": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "challenge": {
        "type": "string",
        "minLength": 43,
        "maxLength": 43
      }
    },
    "required": [
      "proposalId",
      "revision",
      "contentHash",
      "challenge"
    ],
    "additionalProperties": false
  },
  "reject_movie": {
    "type": "object",
    "properties": {
      "proposalId": {
        "type": "string",
        "format": "uuid"
      },
      "revision": {
        "type": "integer",
        "minimum": 1
      },
      "contentHash": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "challenge": {
        "type": "string",
        "minLength": 43,
        "maxLength": 43
      }
    },
    "required": [
      "proposalId",
      "revision",
      "contentHash",
      "challenge"
    ],
    "additionalProperties": false
  },
  "prepare_movie_poster": {
    "type": "object",
    "properties": {
      "operationId": {
        "type": "string",
        "format": "uuid"
      },
      "url": {
        "type": "string",
        "format": "uri",
        "maxLength": 2048,
        "description": "Direct HTTPS image URL, not a webpage."
      },
      "content": {
        "type": "string",
        "minLength": 4,
        "maxLength": 22369624,
        "description": "Image bytes encoded as base64 without a data URL prefix."
      },
      "mediaType": {
        "type": "string",
        "enum": [
          "image/jpeg",
          "image/png",
          "image/webp"
        ]
      },
      "sourceUrl": {
        "type": "string",
        "maxLength": 2048
      },
      "reuseBasis": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      }
    },
    "required": [
      "operationId",
      "reuseBasis"
    ],
    "oneOf": [
      {
        "required": [
          "url"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "content"
              ]
            },
            {
              "required": [
                "sourceUrl"
              ]
            }
          ]
        }
      },
      {
        "required": [
          "content",
          "mediaType"
        ],
        "not": {
          "required": [
            "url"
          ]
        }
      }
    ],
    "additionalProperties": false
  }
}
