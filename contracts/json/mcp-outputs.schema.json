{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "context": {
      "type": "object",
      "properties": {
        "titles": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "title": {
                "type": "string"
              },
              "release": {
                "type": "object",
                "properties": {
                  "year": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 1,
                    "maximum": 9999
                  },
                  "month": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 1,
                    "maximum": 12
                  },
                  "day": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 1,
                    "maximum": 31
                  },
                  "precision": {
                    "enum": [
                      "YEAR",
                      "MONTH",
                      "DAY",
                      "UNKNOWN"
                    ]
                  }
                },
                "required": [
                  "year",
                  "month",
                  "day",
                  "precision"
                ],
                "additionalProperties": false
              },
              "genreIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uuid"
                },
                "maxItems": 20
              },
              "poster": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "assetId": {
                        "type": "string",
                        "format": "uuid"
                      },
                      "url": {
                        "type": "string",
                        "format": "uri"
                      },
                      "mediaType": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "width": {
                        "type": [
                          "integer",
                          "null"
                        ]
                      },
                      "height": {
                        "type": [
                          "integer",
                          "null"
                        ]
                      },
                      "preview": {
                        "enum": [
                          "INCLUDED",
                          "UNAVAILABLE",
                          "OMITTED_BUDGET"
                        ]
                      }
                    },
                    "required": [
                      "assetId",
                      "url",
                      "mediaType",
                      "width",
                      "height",
                      "preview"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "id",
              "title",
              "release",
              "genreIds",
              "poster"
            ],
            "additionalProperties": false
          },
          "maxItems": 20
        },
        "genres": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "label": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "label"
            ],
            "additionalProperties": false
          }
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "label": {
                "type": "string"
              },
              "category": {
                "enum": [
                  "CAST",
                  "CREATOR"
                ]
              },
              "allowsCharacters": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "label",
              "category",
              "allowsCharacters"
            ],
            "additionalProperties": false
          }
        },
        "policyRevision": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "artworkPolicy": {
          "type": "object",
          "properties": {
            "maxInputBytes": {
              "type": "string"
            },
            "formats": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "maxDimensionPx": {
              "type": "integer"
            },
            "maxPixels": {
              "type": "string"
            },
            "maxImageResponseBytes": {
              "type": "integer"
            }
          },
          "required": [
            "maxInputBytes",
            "formats",
            "maxDimensionPx",
            "maxPixels",
            "maxImageResponseBytes"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "titles",
        "genres",
        "roles",
        "policyRevision",
        "artworkPolicy"
      ],
      "additionalProperties": false
    },
    "proposalReview": {
      "type": "object",
      "properties": {
        "proposalId": {
          "type": "string",
          "format": "uuid"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "contentHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "normalizedMovie": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string"
            },
            "originalTitle": {
              "type": [
                "string",
                "null"
              ]
            },
            "synopsis": {
              "type": "string"
            },
            "genreIds": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid"
              },
              "maxItems": 20
            },
            "release": {
              "type": "object",
              "properties": {
                "year": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1,
                  "maximum": 9999
                },
                "month": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1,
                  "maximum": 12
                },
                "day": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1,
                  "maximum": 31
                }
              },
              "required": [
                "year",
                "month",
                "day"
              ],
              "additionalProperties": false
            },
            "runtimeMinutes": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 100000
            },
            "originalLanguage": {
              "type": [
                "string",
                "null"
              ]
            },
            "synopsisLanguage": {
              "type": "string"
            },
            "countries": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "title",
            "originalTitle",
            "synopsis",
            "genreIds",
            "release",
            "runtimeMinutes",
            "originalLanguage",
            "synopsisLanguage",
            "countries"
          ],
          "additionalProperties": false
        },
        "policyRevision": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "status": {
          "const": "REVIEW"
        },
        "reviewResourceUri": {
          "type": "string",
          "pattern": "^spoolin://proposal/[0-9a-f-]{36}/[0-9]+$"
        },
        "poster": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "posterRef": {
                  "type": "string",
                  "format": "uuid"
                },
                "assetId": {
                  "type": "string",
                  "format": "uuid"
                },
                "contentHash": {
                  "type": "string"
                },
                "mediaType": {
                  "type": "string"
                },
                "width": {
                  "type": "integer",
                  "minimum": 0
                },
                "height": {
                  "type": "integer",
                  "minimum": 0
                },
                "sourceUrl": {
                  "type": "string"
                },
                "reuseBasis": {
                  "type": "string"
                },
                "state": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "required": [
                "posterRef",
                "assetId",
                "contentHash",
                "mediaType",
                "width",
                "height",
                "sourceUrl",
                "reuseBasis",
                "state",
                "url"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "reviewUrl": {
          "type": "string",
          "format": "uri"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "field": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "reuseBasis": {
                "type": "string"
              }
            },
            "required": [
              "field",
              "url",
              "reuseBasis"
            ],
            "additionalProperties": false
          }
        },
        "credits": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "properties": {
              "personId": {
                "type": "string",
                "format": "uuid"
              },
              "personName": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              },
              "roleId": {
                "type": "string",
                "format": "uuid"
              },
              "characterNames": {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "billingOrder": {
                "type": "integer",
                "minimum": 0
              },
              "personLabel": {
                "type": "string"
              },
              "roleLabel": {
                "type": "string"
              }
            },
            "required": [
              "roleId"
            ],
            "oneOf": [
              {
                "required": [
                  "personId"
                ],
                "not": {
                  "required": [
                    "personName"
                  ]
                }
              },
              {
                "required": [
                  "personName"
                ],
                "not": {
                  "required": [
                    "personId"
                  ]
                }
              }
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "proposalId",
        "revision",
        "contentHash",
        "expiresAt",
        "normalizedMovie",
        "policyRevision",
        "status",
        "reviewResourceUri",
        "poster",
        "reviewUrl",
        "sources"
      ],
      "additionalProperties": false
    },
    "operationReceipt": {
      "type": "object",
      "properties": {
        "operationId": {
          "type": "string",
          "format": "uuid"
        },
        "state": {
          "enum": [
            "PENDING",
            "SUCCEEDED",
            "FAILED",
            "EXPIRED"
          ]
        },
        "resultId": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "version": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]+$"
        },
        "problem": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "fields": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "path": {
                        "type": "string"
                      },
                      "code": {
                        "type": "string"
                      },
                      "message": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "path",
                      "code",
                      "message"
                    ],
                    "additionalProperties": false
                  }
                },
                "retryAfterMs": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                }
              },
              "required": [
                "code",
                "message",
                "fields",
                "retryAfterMs"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "resultExpired": {
          "type": "boolean"
        }
      },
      "required": [
        "operationId",
        "state",
        "resultExpired"
      ],
      "additionalProperties": false
    },
    "preparedPoster": {
      "type": "object",
      "properties": {
        "posterRef": {
          "type": "string",
          "format": "uuid"
        },
        "assetId": {
          "type": "string",
          "format": "uuid"
        },
        "contentHash": {
          "type": "string"
        },
        "mediaType": {
          "type": "string"
        },
        "width": {
          "type": "integer",
          "minimum": 0
        },
        "height": {
          "type": "integer",
          "minimum": 0
        },
        "sourceUrl": {
          "type": "string"
        },
        "reuseBasis": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "posterRef",
        "assetId",
        "contentHash",
        "mediaType",
        "width",
        "height",
        "sourceUrl",
        "reuseBasis",
        "state",
        "url"
      ],
      "additionalProperties": false
    },
    "proposalQueue": {
      "type": "object",
      "properties": {
        "proposals": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/proposalReview"
          }
        }
      },
      "required": [
        "proposals"
      ],
      "additionalProperties": false
    }
  },
  "toolOutputs": {
    "movie_context": {
      "$ref": "#/$defs/context"
    },
    "propose_movie": {
      "$ref": "#/$defs/proposalReview"
    },
    "movie_operation": {
      "$ref": "#/$defs/operationReceipt"
    },
    "approve_movie": {
      "$ref": "#/$defs/operationReceipt"
    },
    "reject_movie": {
      "$ref": "#/$defs/operationReceipt"
    },
    "prepare_movie_poster": {
      "$ref": "#/$defs/preparedPoster"
    },
    "movie_review_queue": {
      "$ref": "#/$defs/proposalQueue"
    }
  }
}
