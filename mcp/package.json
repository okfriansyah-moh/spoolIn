{
  "name": "@spoolin/mcp",
  "private": true,
  "version": "0.0.0-foundation",
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "check": "tsc --project tsconfig.json --noEmit",
    "lint": "npm run lint --prefix ..",
    "check:dependencies": "depcruise --config ../build-tools/verification-tests/dependency-cruiser.cjs ../build-tools/verification-tests/mcp",
    "test:coverage": "node ../build-tools/verification-tests/pending.mjs mcp-unit",
    "precheck": "node ../build-tools/verification-tests/production_contracts.mjs",
    "prebuild": "node ../build-tools/verification-tests/production_contracts.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/core": "2.3.1",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "zod": "4.6.7",
    "@grpc/grpc-js": "1.14.6",
    "@bufbuild/protobuf": "2.16.0"
  }
}
