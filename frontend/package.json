{
  "name": "@spoolin/frontend",
  "private": true,
  "version": "0.0.0-foundation",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig tsconfig.json",
    "lint": "eslint --config ../build-tools/verification-tests/eslint.config.mjs src vite.config.ts vitest.config.ts --max-warnings 0",
    "check:dependencies": "depcruise --config ../build-tools/verification-tests/dependency-cruiser.cjs src",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "precheck": "node ../build-tools/verification-tests/production_contracts.mjs",
    "prebuild": "node ../build-tools/verification-tests/production_contracts.mjs",
    "dev": "vite --host 127.0.0.1",
    "pretest:coverage": "node ../build-tools/verification-tests/production_contracts.mjs && svelte-kit sync"
  },
  "dependencies": {
    "svelte": "5.57.2"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "4.0.0",
    "@sveltejs/kit": "3.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/svelte": "5.4.2",
    "jsdom": "30.1.3",
    "vite": "8.3.4"
  }
}
