{
  "name": "@spoolin/frontend",
  "private": true,
  "version": "0.0.0-foundation",
  "type": "module",
  "scripts": {
    "build": "cd ../build-tools/verification-tests/frontend && vite build --config ../../../frontend/vite.config.ts",
    "check": "cd ../build-tools/verification-tests/frontend && svelte-kit sync --config ../../../frontend/vite.config.ts && svelte-check --tsconfig tsconfig.json",
    "lint": "npm run lint --prefix ..",
    "check:dependencies": "depcruise --config ../build-tools/verification-tests/dependency-cruiser.cjs ../build-tools/verification-tests/frontend/src",
    "test:coverage": "node ../build-tools/verification-tests/pending.mjs frontend-unit"
  },
  "dependencies": {
    "svelte": "5.57.2"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "4.0.0",
    "@sveltejs/kit": "3.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/svelte": "5.4.2",
    "vite": "8.3.4"
  }
}
