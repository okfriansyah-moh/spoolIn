{
  "uid": "spoolin-docker",
  "title": "SpoolIn Docker infrastructure",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "spoolin",
    "local"
  ],
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "spoolin-prometheus"
        },
        "query": "label_values(container_memory_working_set_bytes, service)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "title": "Collector reachability",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "spoolin-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"cadvisor\"}",
          "legendFormat": "{{service}} {{datname}} {{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Container measurements available",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "spoolin-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(container_memory_working_set_bytes{service=~\"$service\"})",
          "legendFormat": "{{service}} {{datname}} {{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 2,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "CPU cores used",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "spoolin-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(service) (rate(container_cpu_usage_seconds_total{service=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{service}} {{datname}} {{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cores"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Memory working set",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "spoolin-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(service) (container_memory_working_set_bytes{service=~\"$service\"})",
          "legendFormat": "{{service}} {{datname}} {{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 4,
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Memory limit utilization",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "spoolin-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by(service) (container_memory_working_set_bytes{service=~\"$service\"}/container_spec_memory_limit_bytes{service=~\"$service\"}>0)",
          "legendFormat": "{{service}} {{datname}} {{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Network receive bytes/s",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "spoolin-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(service) (rate(container_network_receive_bytes_total{service=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{service}} {{datname}} {{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 6,
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Network transmit bytes/s",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "spoolin-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(service) (rate(container_network_transmit_bytes_total{service=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{service}} {{datname}} {{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 7,
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Container filesystem usage (when supported)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "spoolin-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(service) (container_fs_usage_bytes{service=~\"$service\"})",
          "legendFormat": "{{service}} {{datname}} {{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 8,
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      }
    }
  ],
  "description": "Local Docker Desktop Linux VM measurements. Empty panels indicate unavailable data; inspect collector health."
}
