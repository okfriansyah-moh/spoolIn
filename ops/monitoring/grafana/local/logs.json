{
  "uid": "spoolin-logs",
  "title": "SpoolIn logs",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "spoolin",
    "local"
  ],
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "spoolin-loki"
        },
        "query": "label_values({installation=\"spoolin-local\"}, service)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "level",
        "label": "Level",
        "type": "custom",
        "query": ".*,DEBUG,INFO,WARN,ERROR,debug,info,warn,error",
        "current": {
          "text": "All",
          "value": ".*"
        }
      },
      {
        "name": "search",
        "label": "Search text",
        "type": "textbox",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "title": "Collector reachability",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "spoolin-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"monitoring\",service=~\"loki|alloy\"}",
          "legendFormat": "{{service}} {{datname}} {{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Log entries/s",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "spoolin-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(service) (rate({installation=\"spoolin-local\",service=~\"$service\"}[$__auto]))",
          "legendFormat": "{{service}} {{datname}} {{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 2,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Error log entries/s",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "spoolin-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(service) (rate({installation=\"spoolin-local\",service=~\"$service\"} |~ \"(?i)(error|fatal|panic)\" [$__auto]))",
          "legendFormat": "{{service}} {{datname}} {{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Sensitive lines dropped/s",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "spoolin-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(loki_process_dropped_lines_total{reason=\"sensitive_content\"}[$__rate_interval]))",
          "legendFormat": "{{service}} {{datname}} {{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 4,
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Search logs",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "spoolin-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{installation=\"spoolin-local\",service=~\"$service\",level=~\"$level\"} |= \"$search\"",
          "legendFormat": "{{service}} {{datname}} {{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 8
      }
    }
  ],
  "description": "Local Docker Desktop Linux VM measurements. Empty panels indicate unavailable data; inspect collector health."
}
