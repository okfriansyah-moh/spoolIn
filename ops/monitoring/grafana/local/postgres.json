{
  "uid": "spoolin-postgres",
  "title": "SpoolIn PostgreSQL",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "spoolin",
    "local"
  ],
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "database",
        "label": "Database",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "spoolin-prometheus"
        },
        "query": "label_values(pg_stat_database_numbackends, datname)",
        "includeAll": true,
        "allValue": "spoolin_.*",
        "multi": true,
        "refresh": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "title": "PostgreSQL connection",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "spoolin-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pg_up",
          "legendFormat": "{{service}} {{datname}} {{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Exporter reachability",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "spoolin-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"postgres\"}",
          "legendFormat": "{{service}} {{datname}} {{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 2,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Connections by database",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "spoolin-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pg_stat_database_numbackends{datname=~\"$database\"}",
          "legendFormat": "{{service}} {{datname}} {{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Transactions committed/s",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "spoolin-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(pg_stat_database_xact_commit{datname=~\"$database\"}[$__rate_interval])",
          "legendFormat": "{{service}} {{datname}} {{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 4,
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Transactions rolled back/s",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "spoolin-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(pg_stat_database_xact_rollback{datname=~\"$database\"}[$__rate_interval])",
          "legendFormat": "{{service}} {{datname}} {{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Locks by mode",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "spoolin-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(datname,mode) (pg_locks_count{datname=~\"$database\"})",
          "legendFormat": "{{datname}} {{mode}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 6,
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Deadlocks/s",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "spoolin-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(pg_stat_database_deadlocks{datname=~\"$database\"}[$__rate_interval])",
          "legendFormat": "{{service}} {{datname}} {{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 7,
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Database size",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "spoolin-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pg_database_size_bytes{datname=~\"$database\"}",
          "legendFormat": "{{service}} {{datname}} {{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 8,
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      }
    }
  ],
  "description": "Local Docker Desktop Linux VM measurements. Empty panels indicate unavailable data; inspect collector health."
}
