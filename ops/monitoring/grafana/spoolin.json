      "title": "Owner outcomes",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "spoolin-prometheus"
      },
      "targets": [
        {
          "expr": "sum by(service,outcome,code)(rate(spoolin_operation_results_total{service=~\"$service\",boundary=\"owner\"}[5m]))",
          "refId": "A",
          "legendFormat": "{{service}} {{state}} {{outcome}} {{code}} {{mode}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "spanNulls": false
