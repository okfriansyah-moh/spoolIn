{
  "uid": "spoolin-operations",
  "title": "SpoolIn operations",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "15s",
  "tags": [
    "spoolin",
    "operations"
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Exporter reachability",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "spoolin-prometheus"
      },
      "targets": [
        {
          "expr": "up{service=~\"$service\",job=~\"spoolin-.*\"}",
          "refId": "A",
          "legendFormat": "{{service}} {{state}} {{outcome}} {{code}} {{mode}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "title": "Dependency readiness",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "spoolin-prometheus"
      },
      "targets": [
        {
          "expr": "spoolin_service_ready{service=~\"$service\"}",
          "refId": "A",
          "legendFormat": "{{service}} {{state}} {{outcome}} {{code}} {{mode}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
