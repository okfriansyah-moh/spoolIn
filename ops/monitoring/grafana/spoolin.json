      "id": 4,
      "title": "Operation latency p95",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "spoolin-prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95,sum by(le,service)(rate(spoolin_operation_duration_seconds_bucket{service=~\"$service\",boundary=\"owner\"}[5m])))",
          "refId": "A",
          "legendFormat": "{{service}} {{state}} {{outcome}} {{code}} {{mode}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "spanNulls": false
