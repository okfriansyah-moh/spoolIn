  "description": "Live owner and ingress measurements. An empty panel means no matching series; absent measurements are never replaced with zero. Logical metrics require their production boundary instrumenters.",
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "spoolin-prometheus"
        },
        "query": "label_values(up{job=~\"spoolin-.*\"}, service)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  }
