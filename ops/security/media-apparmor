# Media-only policy; Docker v28.0.4 default file/proc/sys restrictions are retained.
# Namespace-local setup additions follow fixed Bubblewrap v0.11.2 CodecCommand argv.
abi <abi/4.0>,
include <tunables/global>

profile spoolin-media flags=(attach_disconnected,mediate_deleted) {
  network,
  capability,
  /** rwlkm,
  # No-new-privileges forbids a later transition that grants setup permissions.
  # These permissions remain limited by seccomp arguments, mount paths and the kernel's user namespace ownership.
  userns,
  /opt/java/openjdk/bin/java ix,
  /opt/java/openjdk/lib/jspawnhelper ix,
  /usr/bin/bwrap ix,
  /{usr/,}bin/{dash,bash,sh,id,awk,cat,readlink,mkdir,chmod,chown,stat,rm,ls,head,tail,grep,sed,env,true,false,sleep,find,timeout,uname,sha256sum,printf} ix,
  /usr/local/bin/{vips,spoolin-image-header} ix,
  # The complete compound label retains Media under NNP; no attachment lookup or inheritance fallback.
  /usr/bin/prlimit px -> spoolin-media//&spoolin-media-codec,
  signal (receive) peer=unconfined,
  signal (receive) peer=runc,
  signal (receive) peer=crun,
  signal (send,receive) peer=spoolin-media*,
  ptrace (trace,read,tracedby,readby) peer=spoolin-media*,

  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9],[^1-9][^0-9],[^1-9s][^0-9y][^0-9s],[^1-9][^0-9][^0-9][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,
  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,

  # No broad mount permission: setup can only create its fixed private root and destinations.
  mount options=(rw,rslave,silent) -> /,
  mount fstype=tmpfs -> /tmp/,
  mount options=(rw,rbind,silent) /tmp/newroot/ -> /tmp/newroot/,
  mount fstype=tmpfs -> /newroot/{tmp,dev,dev/shm}/,
  mount fstype=proc -> /newroot/proc/,
  mount fstype=devpts -> /newroot/dev/pts/,
  mount options in (ro,rw,bind,rbind,remount,nosuid,nodev,noexec,relatime,noatime,nodiratime,silent) /oldroot/{usr,usr/**,lib,lib/**,lib64,lib64/**,var/spoolin/media/**,dev/**} -> /newroot/{usr,usr/**,lib,lib/**,lib64,lib64/**,input,output/**,dev/**},
  mount options in (ro,rw,bind,rbind,remount,nosuid,nodev,noexec,relatime,noatime,nodiratime,silent) /newroot/proc/{sys,sys/**,sysrq-trigger,irq,irq/**,bus,bus/**} -> /newroot/proc/{sys,sys/**,sysrq-trigger,irq,irq/**,bus,bus/**},
  remount options in (ro,rw,bind,remount,nosuid,nodev,noexec,relatime,noatime,nodiratime,silent) /newroot/{,**},
  mount options=(rw,rprivate,silent) -> /oldroot/,
  pivot_root oldroot=/tmp/oldroot/ /tmp/,
  pivot_root /newroot/,
  umount /oldroot/,
  umount /,
}

profile spoolin-media-codec flags=(attach_disconnected,mediate_deleted) {
  /usr/bin/prlimit ix,
  /usr/local/bin/{vips,spoolin-image-header} ix,
  /usr/** mr,
  /lib{,64}/** mr,
  /input r,
  /output/ r,
  /output/{dimensions,encoded.jpeg,encoded.png,encoded.webp} rw,
  /tmp/{,**} rwkl,
  /dev/{null,zero,random,urandom} rw,
  /proc/{,**} r,
  /sys/{,**} r,
  signal (send,receive) peer=spoolin-media*,
  deny network,
  deny capability,
  deny mount,
  deny umount,
  deny pivot_root,
  deny userns,
  deny ptrace,
}
