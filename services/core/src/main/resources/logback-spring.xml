<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <springProperty scope="context" name="LOG_LEVEL" source="LOG_LEVEL" defaultValue="INFO"/>
  <springProperty scope="context" name="SERVICE_VERSION" source="APP_VERSION" defaultValue="0.0.0-foundation"/>
  <springProperty scope="context" name="SERVICE_ENV" source="SPOOLIN_ENVIRONMENT" defaultValue="local"/>
  <appender name="JSON" class="com.spoolin.support.logging.BoundedJsonAppender">
    <serviceName>core</serviceName>
    <serviceVersion>${SERVICE_VERSION}</serviceVersion>
    <serviceEnvironment>${SERVICE_ENV}</serviceEnvironment>
  </appender>
  <logger name="com.spoolin.core" level="${LOG_LEVEL}"/>
  <root level="${LOG_LEVEL}">
    <appender-ref ref="JSON"/>
  </root>
</configuration>
