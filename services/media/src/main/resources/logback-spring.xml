<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <conversionRule conversionWord="jsonMsg" converterClass="com.spoolin.support.logging.JsonLogMessageConverter"/>
  <springProperty scope="context" name="LOG_LEVEL" source="LOG_LEVEL" defaultValue="INFO"/>
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
      <pattern>{"@timestamp":"%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX}","level":"%level","logger":"%logger{36}","message":%jsonMsg,"thread":"%thread"}%n</pattern>
    </encoder>
  </appender>
  <logger name="com.spoolin.media" level="${LOG_LEVEL}"/>
  <root level="${LOG_LEVEL}">
    <appender-ref ref="CONSOLE"/>
  </root>
</configuration>
