# Selected nonsecret policy settings. Copy to a private local configuration file.
# Present environment values win over that file; only absent values use defaults.
# An empty or invalid explicit value fails validation rather than falling through.
# Service/session adapters adopt these shared rules in their owning tasks.
REGISTRATION_NAME_MIN_CODE_POINTS=2
REGISTRATION_NAME_MAX_CODE_POINTS=100
PERSON_NAME_MIN_CODE_POINTS=1
PERSON_NAME_MAX_CODE_POINTS=100
TITLE_MIN_CODE_POINTS=1
TITLE_MAX_CODE_POINTS=255
ORIGINAL_TITLE_MIN_CODE_POINTS=1
ORIGINAL_TITLE_MAX_CODE_POINTS=255
SYNOPSIS_MIN_CODE_POINTS=1
SYNOPSIS_MAX_CODE_POINTS=5000
CREDIT_ROLE_MIN_CODE_POINTS=1
CREDIT_ROLE_MAX_CODE_POINTS=100
CHARACTER_NAME_MIN_CODE_POINTS=1
CHARACTER_NAME_MAX_CODE_POINTS=200
BIOGRAPHY_MIN_CODE_POINTS=1
BIOGRAPHY_MAX_CODE_POINTS=5000
EMAIL_MAX_CODE_POINTS=254
PASSWORD_MIN_CODE_POINTS=15
PASSWORD_MAX_CODE_POINTS=128
SEARCH_MAX_CODE_POINTS=200
SOURCE_URL_MAX_CODE_POINTS=2048
REUSE_BASIS_MAX_CODE_POINTS=4000
# Text limits count Unicode code points after Unicode White_Space edge trimming.
# Passwords use exact bytes and also have a fixed512-byte new-password ceiling.
# Text maxima must fit the selected metadata/account envelope; min must not exceed max.
ARTWORK_MAX_INPUT_BYTES=5242880
ARTWORK_FORMATS=JPEG,PNG,WEBP
REQUEST_METADATA_BYTES=131072
REQUEST_UPLOAD_ENVELOPE_BYTES=7100000
REQUEST_GRAPHQL_QUERY_BYTES=16384
REQUEST_MAX_DEPTH=8
REQUEST_MAX_FIELDS=200
REQUEST_MAX_ALIASES=20
REQUEST_MAX_COST=1000
REQUEST_DEFAULT_PAGE=24
REQUEST_MAX_PAGE=100
# Retry bounds: retries0..9; base1..60000ms; cap1..3600000ms and >=base;
# deadline1000..3600000ms; multiplier1..10. Jitter is the fixed source algorithm.
RETRY_MAX_RETRIES=2
RETRY_BASE_DELAY_MS=500
RETRY_MAX_DELAY_MS=5000
RETRY_DEADLINE_MS=60000
RETRY_MULTIPLIER=2
# Quotas are positive Int values; windows are1..86400seconds.
RATE_LIMIT_SIGNIN_ACCOUNT_MAX_REQUESTS=10
RATE_LIMIT_SIGNIN_ACCOUNT_WINDOW_SECONDS=900
RATE_LIMIT_SIGNIN_SOURCE_MAX_REQUESTS=60
RATE_LIMIT_SIGNIN_SOURCE_WINDOW_SECONDS=900
RATE_LIMIT_REGISTER_MAX_REQUESTS=5
RATE_LIMIT_REGISTER_WINDOW_SECONDS=3600
RATE_LIMIT_MUTATION_MAX_REQUESTS=60
RATE_LIMIT_MUTATION_WINDOW_SECONDS=60
RATE_LIMIT_READ_MAX_REQUESTS=120
RATE_LIMIT_READ_WINDOW_SECONDS=60
MCP_RATE_LIMIT_MAX_BINDINGS=1024
LOG_LEVEL=info
NOTIFICATION_MODE=database
# SMTP requires host/from/to; optional authentication requires both username and
# password-file reference. Port defaults587; TLS certificate verification is required.
# SMTP_HOST=smtp.example.test
# SMTP_PORT=587
# SMTP_TLS_VERIFY=true
# SMTP_FROM=sender@example.test
# SMTP_TO=recipient@example.test
# SMTP_USERNAME=service-account
# SMTP_PASSWORD_FILE=/private/spoolin/smtp-password
# Slack selects one webhook-file OR bot-token-file plus channel.
# SLACK_WEBHOOK_FILE=/private/spoolin/slack-webhook
# SLACK_BOT_TOKEN_FILE=/private/spoolin/slack-token
# SLACK_CHANNEL=selected-channel
# Google Chat selects one webhook-file OR credential-file plus space.
# GOOGLE_CHAT_WEBHOOK_FILE=/private/spoolin/chat-webhook
# GOOGLE_CHAT_CREDENTIAL_FILE=/private/spoolin/chat-credential
# GOOGLE_CHAT_SPACE=selected-space
# Tunnel defaults enabled: supply all three references when enabled.
TUNNEL_ENABLED=true
# TUNNEL_ID=selected-tunnel
# TUNNEL_KEY_FILE=/private/spoolin/tunnel-key
# TUNNEL_RUNNER_PATH=/private/spoolin/tunnel-runner
MCP_PUBLICATION_ENABLED=false
# MCP_UI_ASSERTION_KEY_FILE=/private/spoolin/ui-assertion-key
# MCP_UI_ASSERTION_KEY_ID=ui-key-v1
# Required credentials/key/certificate references have no default or inline value.
# Supply owner-only protected files; placeholders below are comments, not usable keys.
# SERVICE_CERT_FILE=/private/spoolin/service-cert
# SERVICE_KEY_FILE=/private/spoolin/service-private-key
# SERVICE_CA_FILE=/private/spoolin/service-ca
# CORE_DB_URL=jdbc:postgresql://db:5432/spoolin_core?sslmode=verify-full
# CORE_DB_USER=spoolin_core_runtime
# CORE_DB_PASSWORD_FILE=/private/spoolin/core-db-password
# CATALOG_DB_URL=jdbc:postgresql://db:5432/spoolin_catalog?sslmode=verify-full
# CATALOG_DB_USER=spoolin_catalog_runtime
# CATALOG_DB_PASSWORD_FILE=/private/spoolin/catalog-db-password
# MEDIA_DB_URL=jdbc:postgresql://db:5432/spoolin_media?sslmode=verify-full
# MEDIA_DB_USER=spoolin_media_runtime
# MEDIA_DB_PASSWORD_FILE=/private/spoolin/media-db-password
# BROWSER_ORIGIN=https://localhost:8443
# PII_KEY_FILE=/private/spoolin/pii-key
# DRAFT_KEY_FILE=/private/spoolin/draft-key
# EMAIL_LOOKUP_KEY_FILE=/private/spoolin/email-lookup-key
# OPERATION_HMAC_KEY_FILE=/private/spoolin/operation-hmac-key
# CURSOR_KEY_FILE=/private/spoolin/cursor-key
# CSRF_KEY_FILE=/private/spoolin/csrf-key
# RATE_LIMIT_KEY_FILE=/private/spoolin/rate-key
# ACTOR_SIGNING_PRIVATE_KEY_FILE=/private/spoolin/actor-signing-key
# ACTOR_SIGNING_KEY_ID=actor-v1
# PII_KEY_ID=pii-v1
# DRAFT_KEY_ID=draft-v1
# EMAIL_LOOKUP_KEY_ID=lookup-v1
# OPERATION_HMAC_KEY_ID=operation-v1
# ACTOR_VERIFY_KEYS_FILE=/private/spoolin/actor-verify-map
# VIEWER_IDENTITY_FILE=/private/spoolin/viewer-identity
# VIEWER_PASSWORD_FILE=/private/spoolin/viewer-password
# MAINTAINER_IDENTITY_FILE=/private/spoolin/maintainer-identity
# MAINTAINER_PASSWORD_FILE=/private/spoolin/maintainer-password
# Crypto sizes, protected modes, ports, DB timeouts/pool, engineering processing
# limits and wire capacities are compatibility facts, not arbitrary env overrides.
# See tests/contracts/policy/config-contract.json for source, units and bounds.
