{
  "name": "spoolin",
  "private": true,
  "version": "0.0.0-foundation",
  "type": "module",
  "workspaces": [
    "frontend",
    "mcp",
    "tests/browser"
  ],
  "engines": {
    "node": "24.21.0",
    "npm": "11.19.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "check": "npm run check --workspace frontend && npm run check --workspace mcp",
    "lint": "eslint --config build-tools/verification-tests/eslint.config.mjs build-tools/verification-tests frontend/src tests/browser/flows/shell --max-warnings 0",
    "format:check": "prettier --config build-tools/verification-tests/prettier.config.mjs --ignore-path .gitignore --check build-tools/verification-tests frontend/src frontend/*.json frontend/*.ts mcp/*.json tests/browser/*.json tests/browser/*.ts tests/browser/flows/shell package.json",
    "build": "npm run build --workspace frontend && npm run build --workspace mcp",
    "test:e2e": "npm run test --workspace tests/browser",
    "generate:fixture": "node build-tools/verification-tests/graphql/codegen.mjs",
    "generate:graphql": "node build-tools/generate-graphql.mjs",
    "generate:grpc": "./gradlew :contracts:grpc:generateProto",
    "generate": "node build-tools/verification-tests/production_contracts.mjs --required"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.10.0",
    "@vitest/coverage-v8": "5.0.4",
    "dependency-cruiser": "18.6.0",
    "eslint": "10.12.0",
    "eslint-plugin-svelte": "3.23.1",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4",
    "graphql": "17.0.2",
    "@graphql-codegen/typescript": "6.1.2",
    "@graphql-codegen/typescript-operations": "6.1.10",
    "@graphql-codegen/typed-document-node": "7.2.0",
    "ts-proto": "2.15.3",
    "@graphql-typed-document-node/core": "3.2.0",
    "@graphql-codegen/core": "6.2.2"
  }
}
